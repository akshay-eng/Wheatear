engine/orchestrate-migration/
orchestrate-migration/
*-migration/
foundry-output/
test-export.zip

# n8n exploration artifacts -- workflow exports, KB source files, generated
# reference docs. Not part of the corridor engine itself.
hr-agentassets/
n8n-export/
n8n-export.zip
n8n-feature-matrix/

# ---------------------------------------------------------------------------
# Credentials and captured sessions.
#
# A HAR holds live session cookies and anything typed while recording. A
# console cookie is a live credential: whoever holds it is the signed-in user.
# None of this belongs in version control even briefly -- a deleted secret
# stays in the history.
# ---------------------------------------------------------------------------
*.har
cookie*.txt
cookies.txt
*.pem
*.key
!**/*.key.example
.env
.env.*
!.env.example
secrets.*
*credentials*.json
*_token.txt

# Reference assets + migration outputs (real exports, PDFs, deployed YAML).
migration_assets/
n8n-migration/

# Large scraped n8n node catalog (2MB) -- optional enrichment only, not on the
# migration critical path; the Orchestrate catalog-snapshot.json IS committed.
engine/wheatear/connectors/orchestrate/data/n8n-node-catalog-snapshot.json

